# Variables para docker-compose.local.yml (stack mysql + backend + frontend).
# Copiar a .env y completar. Nunca commitear el .env real.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=don_pepito_web_local
MYSQL_USER=don_pepito_app
MYSQL_PASSWORD=

ALLOWED_BD_NAME=don_pepito_web
JWT_SECRET=
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/images

# Usuario de desarrollo local (para `docker compose ... exec backend npm run seed:user`)
LOCAL_DEV_USER=dev.local@donpepito.test
LOCAL_DEV_PASSWORD=

VITE_WHATSAPP_PHONE=946762926
VITE_IMAGE_UPLOAD_URL=https://api-centralizador.apiworking.pe/api/Data/images
