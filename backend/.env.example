PORT=4000
# En producción, nunca cambiar esto: el backend solo debe ser accesible vía
# el proxy de nginx, nunca directo desde internet.
HOST=127.0.0.1
NODE_ENV=development

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=don_pepito_web_local
MYSQL_USER=
MYSQL_PASSWORD=

# Debe coincidir con VITE_BD_NAME del frontend. Cualquier otro valor de
# ?bd= en la query string es rechazado con 400 (no se acepta bd arbitrario).
ALLOWED_BD_NAME=don_pepito_web

JWT_SECRET=
JWT_EXPIRES_IN=12h

CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/images

# Usuario de desarrollo local (npm run seed:user y los tests lo usan para
# loguearse). Obligatorio: sin esta variable el seed y los tests fallan con
# un mensaje claro en vez de usar una contraseña hardcodeada. Nunca se
# imprime en consola. LOCAL_DEV_USER es opcional (tiene un default).
LOCAL_DEV_USER=dev.local@donpepito.test
LOCAL_DEV_PASSWORD=
